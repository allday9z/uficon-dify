# ==============================================================================
# Dify Production Environment Variables for Coolify
# ==============================================================================

# Core Encryption Key
# Generate with: openssl rand -base64 32
SECRET_KEY=

# PostgreSQL Database (Dedicated DB)
DB_USERNAME=postgres
DB_PASSWORD=
DB_HOST=192.168.1.46
DB_PORT=5432
DB_DATABASE=dify

# Redis Configuration (Cache & Broker)
REDIS_HOST=192.168.1.45
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_USE_SSL=false

# Celery Worker Connection (Redis DB 1)
CELERY_BROKER_URL=redis://:PASSWORD@192.168.1.45:6379/1
CELERY_BACKEND=redis
BROKER_USE_SSL=false

# URLs (Leave empty or set to unified domain)
CONSOLE_API_URL=
CONSOLE_WEB_URL=
SERVICE_API_URL=
APP_API_URL=
APP_WEB_URL=
